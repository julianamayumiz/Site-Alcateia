{
  "rules": {
    "alcateia": {
      ".read": "auth != null && root.child('usuarios').child(auth.uid).child('ativo').val() === true",
      ".write": "auth != null && root.child('usuarios').child(auth.uid).child('ativo').val() === true"
    },
    "usuarios": {
      ".read": "auth != null && root.child('usuarios').child(auth.uid).child('papel').val() === 'admin'",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && root.child('usuarios').child(auth.uid).child('papel').val() === 'admin'"
      }
    }
  }
}
