{
  "rules": {
    "alcateia": {
      ".read": "auth != null && root.child('alcateia/usuarios').child(auth.uid).child('ativo').val() === true",

      "usuarios": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && root.child('alcateia/usuarios').child(auth.uid).child('papel').val() === 'admin'"
        }
      },

      "$secao": {
        ".write": "$secao != 'usuarios' && auth != null && root.child('alcateia/usuarios').child(auth.uid).child('ativo').val() === true"
      }
    }
  }
}
